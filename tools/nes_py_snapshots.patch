+
+    /// A full machine state, so many save states can exist at once
+    /// (added for SuperMarioBros RL: start episodes from mid-level saves)
+    struct State {
+        MainBus bus;
+        PictureBus picture_bus;
+        CPU cpu;
+        PPU ppu;
+    };
+
+    /// Return a new heap-allocated copy of the current state.
+    inline State* snapshot() { return new State{bus, picture_bus, cpu, ppu}; }
+
+    /// Load a state created by snapshot().
+    inline void load(const State* s) {
+        bus = s->bus;
+        picture_bus = s->picture_bus;
+        cpu = s->cpu;
+        ppu = s->ppu;
+    }
 };
 
